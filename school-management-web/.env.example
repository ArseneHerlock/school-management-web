# ==============================================================================
# CẤU HÌNH CỔNG THANH TOÁN TRỰC TUYẾN TỰ ĐỘNG (VNPAY / MOMO)
# ==============================================================================

# 1. CỔNG THANH TOÁN VNPAY (VNPAY-QR, Thẻ ATM Napas, Thẻ quốc tế Visa/Master)
# Thông tin cấu hình do VNPay cấp:
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://pay.vnpayment.vn/vpcpay.html
VNPAY_RETURN_URL=

# 2. CỔNG THANH TOÁN VÍ MOMO (Ứng dụng MoMo, MoMo QR)
# Thông tin cấu hình do MoMo cấp:
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_URL=https://payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=
MOMO_IPN_URL=

# 3. KẾT NỐI HỆ THỐNG NỘI BỘ
JWT_KEY=SchoolManagementSystem-Jwt-Key-2026-Strong!
BACKEND_BILLING_URL=http://127.0.0.1:5257
